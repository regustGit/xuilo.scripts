local function makePanel(parent, props, bgKey, strokeKey)
    local f = new("Frame", props or {})
    f.BorderSizePixel = 0; f.Parent = parent
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 4); c.Parent = f
    local s = Instance.new("UIStroke"); s.Thickness = 1; s.Transparency = 0.3; s.Parent = f
    bind(f, "BackgroundColor3", bgKey or "Panel")
    bind(s, "Color", strokeKey or "PanelStroke")
    return f
end

