-- ============================================================
-- XuiloUI – библиотека для создания UI (полная версия)
-- ============================================================

local XuiloUI = {}

-- Тема оформления
local Theme = {
	Panel = Color3.fromRGB(18, 18, 20),
	Sidebar = Color3.fromRGB(14, 14, 16),
	Stroke = Color3.fromRGB(60, 60, 64),
	Text = Color3.fromRGB(240, 240, 242),
	SubText = Color3.fromRGB(140, 140, 145),
	Btn = Color3.fromRGB(28, 28, 31),
	BtnHover = Color3.fromRGB(40, 40, 44),
	BtnText = Color3.fromRGB(235, 235, 238),
	TabActive = Color3.fromRGB(235, 235, 238),
	TabActiveText = Color3.fromRGB(18, 18, 20),
}
XuiloUI.Theme = Theme

-- Сервисы
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local TextService = game:GetService("TextService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Глобальные объекты
local ScreenGui = nil
local Tooltip = nil
local TooltipLabel = nil
local TooltipStroke = nil
local windows = {}

-- ============================================================
-- ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
-- ============================================================

local function addSoftShadow(target, cornerRadius, maxExtraPixels)
	maxExtraPixels = maxExtraPixels or 12
	local layers = {
		{extra = maxExtraPixels * 0.35, transparency = 0.85},
		{extra = maxExtraPixels * 0.65, transparency = 0.91},
		{extra = maxExtraPixels, transparency = 0.95},
	}

	local shadows = {}
	for i, layer in ipairs(layers) do
		local Shadow = Instance.new("Frame")
		Shadow.Name = "Shadow" .. i
		Shadow.AnchorPoint = Vector2.new(0.5, 0.5)
		Shadow.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		Shadow.BackgroundTransparency = layer.transparency
		Shadow.BorderSizePixel = 0
		Shadow.ZIndex = math.max(target.ZIndex - 1, 0)
		Instance.new("UICorner", Shadow).CornerRadius = UDim.new(0, cornerRadius + layer.extra / 2)
		Shadow.Parent = target.Parent
		shadows[i] = {frame = Shadow, extra = layer.extra}
	end

	local function sync()
		local size = target.AbsoluteSize
		local pos = target.AbsolutePosition
		local centerX = pos.X + size.X / 2
		local centerY = pos.Y + size.Y / 2 + 2
		for _, entry in ipairs(shadows) do
			entry.frame.Size = UDim2.fromOffset(size.X + entry.extra, size.Y + entry.extra)
			entry.frame.Position = UDim2.fromOffset(centerX, centerY)
			entry.frame.Visible = target.Visible and size.X > 0 and size.Y > 0
		end
	end

	target:GetPropertyChangedSignal("AbsoluteSize"):Connect(sync)
	target:GetPropertyChangedSignal("AbsolutePosition"):Connect(sync)
	target:GetPropertyChangedSignal("Visible"):Connect(sync)
	sync()
end

local function makeDraggable(handle, target)
	local dragging, dragStart, startPos
	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = target.Position
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			local goal = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
			TweenService:Create(target, TweenInfo.new(0.1), {Position = goal}):Play()
		end
	end)
	handle.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
	end)
end

local function addCursorTilt(handle, target, maxAngle)
	maxAngle = maxAngle or 4
	local hovering = false

	handle.InputChanged:Connect(function(input)
		if not hovering then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			local size = target.AbsoluteSize
			local pos = target.AbsolutePosition
			local relX = (input.Position.X - pos.X) / math.max(size.X, 1)
			local angle = (relX - 0.5) * 2 * maxAngle
			TweenService:Create(target, TweenInfo.new(0.35, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Rotation = angle}):Play()
		end
	end)

	handle.MouseEnter:Connect(function()
		hovering = true
	end)

	handle.MouseLeave:Connect(function()
		hovering = false
		TweenService:Create(target, TweenInfo.new(0.4, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Rotation = 0}):Play()
	end)
end

-- Tooltip
local function initTooltip()
	if Tooltip then return end
	if not ScreenGui then
		ScreenGui = Instance.new("ScreenGui")
		ScreenGui.Name = "XuiloUI"
		ScreenGui.ResetOnSpawn = false
		ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
	end
	Tooltip = Instance.new("Frame", ScreenGui)
	Tooltip.BackgroundColor3 = Theme.Panel
	Tooltip.BorderSizePixel = 0
	Tooltip.Visible = false
	Tooltip.ZIndex = 50
	Instance.new("UICorner", Tooltip).CornerRadius = UDim.new(0, 10)
	TooltipStroke = Instance.new("UIStroke", Tooltip)
	TooltipStroke.Thickness = 1
	TooltipStroke.Color = Theme.Stroke
	TooltipStroke.Transparency = 0.3

	TooltipLabel = Instance.new("TextLabel", Tooltip)
	TooltipLabel.Size = UDim2.new(1, 0, 1, 0)
	TooltipLabel.BackgroundTransparency = 1
	TooltipLabel.Font = Enum.Font.Gotham
	TooltipLabel.TextSize = 11
	TooltipLabel.TextColor3 = Theme.Text
	TooltipLabel.ZIndex = 51
end

local function showTooltip(anchor, text)
	if not Tooltip then initTooltip() end
	local textSize = TextService:GetTextSize(text, 11, Enum.Font.Gotham, Vector2.new(300, 20))
	local width = textSize.X + 20
	local height = 26

	local pos = anchor.AbsolutePosition
	local size = anchor.AbsoluteSize

	TooltipLabel.Text = text
	Tooltip.Size = UDim2.fromOffset(width, height)
	Tooltip.Position = UDim2.fromOffset(pos.X + size.X + 10, pos.Y + size.Y / 2 - height / 2)
	Tooltip.BackgroundTransparency = 1
	TooltipLabel.TextTransparency = 1
	TooltipStroke.Transparency = 1
	Tooltip.Visible = true

	TweenService:Create(Tooltip, TweenInfo.new(0.12), {BackgroundTransparency = 0}):Play()
	TweenService:Create(TooltipStroke, TweenInfo.new(0.12), {Transparency = 0.3}):Play()
	TweenService:Create(TooltipLabel, TweenInfo.new(0.12), {TextTransparency = 0}):Play()
end

local function hideTooltip()
	if not Tooltip then return end
	local tween = TweenService:Create(Tooltip, TweenInfo.new(0.1), {BackgroundTransparency = 1})
	TweenService:Create(TooltipStroke, TweenInfo.new(0.1), {Transparency = 1}):Play()
	TweenService:Create(TooltipLabel, TweenInfo.new(0.1), {TextTransparency = 1}):Play()
	tween:Play()
	tween.Completed:Connect(function()
		Tooltip.Visible = false
	end)
end

local function addTooltip(button, text)
	button.MouseEnter:Connect(function()
		showTooltip(button, text)
	end)
	button.MouseLeave:Connect(function()
		hideTooltip()
	end)
end

-- ============================================================
-- КЛАСС WINDOW
-- ============================================================

local Window = {}
Window.__index = Window

function Window.new(config)
	config = config or {}
	local self = setmetatable({}, Window)
	self.Title = config.Title or "XuiloUI"
	self.Size = config.Size or UDim2.fromOffset(360, 300)
	self.Position = config.Position or UDim2.new(0.5, -180, 0.5, -150)
	self.Theme = config.Theme or Theme
	self.DefaultOpen = (config.DefaultOpen ~= false)
	self.ShowToggleButton = (config.ShowToggleButton ~= false)
	self.LoadingEnabled = (config.LoadingEnabled ~= false)
	self.Tabs = {}
	self.ActiveTabIndex = nil
	self.IsOpen = self.DefaultOpen
	self.Animating = false

	if not ScreenGui then
		ScreenGui = Instance.new("ScreenGui")
		ScreenGui.Name = "XuiloUI"
		ScreenGui.ResetOnSpawn = false
		ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
	end
	initTooltip()

	-- Основное окно
	local MainFrame = Instance.new("Frame", ScreenGui)
	MainFrame.Size = self.LoadingEnabled and UDim2.fromOffset(96, 96) or self.Size
	MainFrame.Position = self.LoadingEnabled and UDim2.new(0.5, -48, 0.5, -48) or self.Position
	MainFrame.BackgroundColor3 = self.Theme.Panel
	MainFrame.ClipsDescendants = true
	MainFrame.Visible = self.DefaultOpen or not self.LoadingEnabled
	Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 22)
	local MainStroke = Instance.new("UIStroke", MainFrame)
	MainStroke.Thickness = 1
	MainStroke.Color = self.Theme.Stroke
	MainStroke.Transparency = 0.35
	addSoftShadow(MainFrame, 22, 14)
	self.MainFrame = MainFrame

	-- Группа загрузки
	local LoadingGroup = Instance.new("CanvasGroup", MainFrame)
	LoadingGroup.Size = UDim2.new(1, 0, 1, 0)
	LoadingGroup.BackgroundTransparency = 1
	LoadingGroup.GroupTransparency = 0
	self.LoadingGroup = LoadingGroup

	if self.LoadingEnabled then
		local Spinner = Instance.new("Frame", LoadingGroup)
		Spinner.Size = UDim2.new(0, 24, 0, 24)
		Spinner.AnchorPoint = Vector2.new(0.5, 1)
		Spinner.Position = UDim2.new(0.5, 0, 1, -14)
		Spinner.BackgroundTransparency = 1

		local SpinnerStroke = Instance.new("UIStroke", Spinner)
		SpinnerStroke.Thickness = 3
		SpinnerStroke.Color = self.Theme.Text
		SpinnerStroke.Transparency = 0.1

		local SpinnerGradient = Instance.new("UIGradient", Spinner)
		SpinnerGradient.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.25, 0.4),
			NumberSequenceKeypoint.new(0.6, 0.9),
			NumberSequenceKeypoint.new(1, 1),
		})
		Instance.new("UICorner", Spinner).CornerRadius = UDim.new(1, 0)

		local LoadingLabel = Instance.new("TextLabel", LoadingGroup)
		LoadingLabel.Size = UDim2.new(1, 0, 0, 16)
		LoadingLabel.Position = UDim2.new(0, 0, 0.5, -20)
		LoadingLabel.BackgroundTransparency = 1
		LoadingLabel.Text = "xuilo.ui"
		LoadingLabel.Font = Enum.Font.GothamBold
		LoadingLabel.TextSize = 13
		LoadingLabel.TextColor3 = self.Theme.Text

		local spinnerTween = TweenService:Create(Spinner, TweenInfo.new(1.6, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1), {Rotation = 360})
		spinnerTween:Play()
		self.SpinnerTween = spinnerTween
		self.Spinner = Spinner
	else
		LoadingGroup.GroupTransparency = 1
		LoadingGroup.Visible = false
	end

	-- Меню
	local MenuGroup = Instance.new("CanvasGroup", MainFrame)
	MenuGroup.Size = UDim2.new(1, 0, 1, 0)
	MenuGroup.BackgroundTransparency = 1
	MenuGroup.GroupTransparency = self.LoadingEnabled and 1 or 0
	MenuGroup.Visible = self.LoadingEnabled and false or true
	self.MenuGroup = MenuGroup

	-- Хедер
	local Header = Instance.new("Frame", MenuGroup)
	Header.Size = UDim2.new(1, 0, 0, 40)
	Header.BackgroundTransparency = 1
	self.Header = Header

	local Icon = Instance.new("Frame", Header)
	Icon.Size = UDim2.new(0, 6, 0, 6)
	Icon.Position = UDim2.new(0, 16, 0.5, -3)
	Icon.BackgroundColor3 = self.Theme.Text
	Instance.new("UICorner", Icon).CornerRadius = UDim.new(1, 0)

	local Title = Instance.new("TextLabel", Header)
	Title.Size = UDim2.new(1, -70, 1, 0)
	Title.Position = UDim2.new(0, 32, 0, 0)
	Title.BackgroundTransparency = 1
	Title.Text = self.Title
	Title.Font = Enum.Font.Gotham
	Title.TextSize = 14
	Title.TextColor3 = self.Theme.Text
	Title.TextXAlignment = Enum.TextXAlignment.Left
	self.TitleLabel = Title

	local CloseBtn = Instance.new("TextButton", Header)
	CloseBtn.Size = UDim2.new(0, 28, 0, 28)
	CloseBtn.Position = UDim2.new(1, -38, 0.5, -14)
	CloseBtn.BackgroundTransparency = 1
	CloseBtn.Text = "×"
	CloseBtn.Font = Enum.Font.Gotham
	CloseBtn.TextSize = 18
	CloseBtn.TextColor3 = self.Theme.SubText
	CloseBtn.AutoButtonColor = false
	self.CloseBtn = CloseBtn

	CloseBtn.MouseEnter:Connect(function()
		TweenService:Create(CloseBtn, TweenInfo.new(0.15), {TextColor3 = self.Theme.Text}):Play()
	end)
	CloseBtn.MouseLeave:Connect(function()
		TweenService:Create(CloseBtn, TweenInfo.new(0.15), {TextColor3 = self.Theme.SubText}):Play()
	end)

	local Divider = Instance.new("Frame", MenuGroup)
	Divider.Size = UDim2.new(1, -32, 0, 1)
	Divider.Position = UDim2.new(0, 16, 0, 40)
	Divider.BackgroundColor3 = self.Theme.Stroke
	Divider.BackgroundTransparency = 0.5
	Divider.BorderSizePixel = 0

	-- Сайдбар
	local Sidebar = Instance.new("Frame", MenuGroup)
	Sidebar.Size = UDim2.new(0, 70, 1, -49)
	Sidebar.Position = UDim2.new(0, 0, 0, 49)
	Sidebar.BackgroundColor3 = self.Theme.Sidebar
	Sidebar.BorderSizePixel = 0
	self.Sidebar = Sidebar

	local SidebarPadding = Instance.new("UIPadding", Sidebar)
	SidebarPadding.PaddingTop = UDim.new(0, 12)
	SidebarPadding.PaddingLeft = UDim.new(0, 12)
	SidebarPadding.PaddingRight = UDim.new(0, 12)

	local SidebarList = Instance.new("UIListLayout", Sidebar)
	SidebarList.Padding = UDim.new(0, 8)
	SidebarList.HorizontalAlignment = Enum.HorizontalAlignment.Center
	self.SidebarList = SidebarList

	local SidebarBottomFix = Instance.new("Frame", MenuGroup)
	SidebarBottomFix.Size = UDim2.new(0, 70, 0, 22)
	SidebarBottomFix.Position = UDim2.new(0, 0, 1, -22)
	SidebarBottomFix.BackgroundColor3 = self.Theme.Sidebar
	SidebarBottomFix.BorderSizePixel = 0
	SidebarBottomFix.ZIndex = 2
	Instance.new("UICorner", SidebarBottomFix).CornerRadius = UDim.new(0, 22)

	-- Область контента
	local ContentArea = Instance.new("Frame", MenuGroup)
	ContentArea.Size = UDim2.new(1, -70, 1, -49)
	ContentArea.Position = UDim2.new(0, 70, 0, 49)
	ContentArea.BackgroundTransparency = 1
	ContentArea.ClipsDescendants = true
	self.ContentArea = ContentArea

	-- Перетаскивание
	makeDraggable(Header, MainFrame)
	addCursorTilt(MainFrame, MainFrame, 3)

	-- Кнопка открытия
	if self.ShowToggleButton then
		local OpenBtn = Instance.new("TextButton", ScreenGui)
		OpenBtn.Size = UDim2.new(0, 44, 0, 44)
		OpenBtn.Position = UDim2.new(0, 20, 0, 20)
		OpenBtn.BackgroundColor3 = self.Theme.Panel
		OpenBtn.Text = "≡"
		OpenBtn.Font = Enum.Font.Gotham
		OpenBtn.TextSize = 18
		OpenBtn.TextColor3 = self.Theme.Text
		OpenBtn.AutoButtonColor = false
		OpenBtn.Visible = true
		Instance.new("UICorner", OpenBtn).CornerRadius = UDim.new(0, 14)
		local OpenBtnStroke = Instance.new("UIStroke", OpenBtn)
		OpenBtnStroke.Thickness = 1
		OpenBtnStroke.Color = self.Theme.Stroke
		OpenBtnStroke.Transparency = 0.4
		addSoftShadow(OpenBtn, 10, 10)
		addCursorTilt(OpenBtn, OpenBtn, 5)
		makeDraggable(OpenBtn, OpenBtn)

		OpenBtn.MouseEnter:Connect(function()
			TweenService:Create(OpenBtn, TweenInfo.new(0.15), {BackgroundColor3 = self.Theme.BtnHover}):Play()
		end)
		OpenBtn.MouseLeave:Connect(function()
			TweenService:Create(OpenBtn, TweenInfo.new(0.15), {BackgroundColor3 = self.Theme.Panel}):Play()
		end)

		self.OpenBtn = OpenBtn

		OpenBtn.MouseButton1Click:Connect(function()
			if self.IsOpen then
				self:Close()
			else
				self:Open()
			end
		end)
	end

	-- Закрытие по крестику
	CloseBtn.MouseButton1Click:Connect(function()
		self:Close()
	end)

	-- Анимация загрузки
	if self.LoadingEnabled then
		task.spawn(function()
			task.wait(1.1)
			local fadeOutTween = TweenService:Create(LoadingGroup, TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {GroupTransparency = 1})
			fadeOutTween:Play()
			fadeOutTween.Completed:Wait()
			if self.SpinnerTween then self.SpinnerTween:Cancel() end
			LoadingGroup.Visible = false

			local expandTween = TweenService:Create(MainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
				Size = self.Size,
				Position = self.Position,
			})
			expandTween:Play()
			expandTween.Completed:Wait()

			MenuGroup.Visible = true
			TweenService:Create(MenuGroup, TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {GroupTransparency = 0}):Play()

			self.IsOpen = true
			if self.Tabs[1] then
				self:SelectTab(1)
			end
		end)
	else
		MenuGroup.Visible = true
		MenuGroup.GroupTransparency = 0
		self.IsOpen = self.DefaultOpen
		if self.DefaultOpen and self.Tabs[1] then
			self:SelectTab(1)
		end
	end

	table.insert(windows, self)
	return self
end

-- Методы Window

function Window:Open()
	if self.IsOpen or self.Animating then return end
	self.IsOpen = true
	self.MainFrame.Visible = true
	self.MainFrame.Size = UDim2.new(0, self.Size.X.Offset, 0, 36)
	TweenService:Create(self.MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		Size = self.Size,
	}):Play()
end

function Window:Close()
	if not self.IsOpen or self.Animating then return end
	self.IsOpen = false
	local tween = TweenService:Create(self.MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.In), {
		Size = UDim2.new(0, self.Size.X.Offset, 0, 0),
	})
	tween:Play()
	tween.Completed:Connect(function()
		if not self.IsOpen then
			self.MainFrame.Visible = false
		end
	end)
end

function Window:Toggle()
	if self.IsOpen then
		self:Close()
	else
		self:Open()
	end
end

function Window:SetPosition(pos)
	self.Position = pos
	self.MainFrame.Position = pos
end

function Window:Destroy()
	for i, win in ipairs(windows) do
		if win == self then
			table.remove(windows, i)
			break
		end
	end
	if self.OpenBtn then self.OpenBtn:Destroy() end
	self.MainFrame:Destroy()
	if #windows == 0 and ScreenGui then
		ScreenGui:Destroy()
		ScreenGui = nil
		Tooltip = nil
		TooltipLabel = nil
		TooltipStroke = nil
	end
end

function Window:CreateTab(name, icon)
	icon = icon or ""
	local tab = {}
	tab.Window = self
	tab.Name = name
	tab.Icon = icon
	tab.Buttons = {}

	local btn = Instance.new("TextButton", self.Sidebar)
	btn.Size = UDim2.new(0, 46, 0, 46)
	btn.BackgroundColor3 = self.Theme.Btn
	btn.Text = ""
	btn.AutoButtonColor = false
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 14)

	local iconLabel = Instance.new("ImageLabel", btn)
	iconLabel.Name = "Icon"
	iconLabel.Size = UDim2.new(0, 22, 0, 22)
	iconLabel.AnchorPoint = Vector2.new(0.5, 0.5)
	iconLabel.Position = UDim2.new(0.5, 0, 0.5, 0)
	iconLabel.BackgroundTransparency = 1
	iconLabel.Image = icon
	iconLabel.ImageColor3 = self.Theme.Text
	iconLabel.ScaleType = Enum.ScaleType.Fit
	tab.Button = btn

	btn.MouseEnter:Connect(function()
		if btn:GetAttribute("Active") then return end
		TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = self.Theme.BtnHover}):Play()
	end)
	btn.MouseLeave:Connect(function()
		if btn:GetAttribute("Active") then return end
		TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = self.Theme.Btn}):Play()
	end)

	addTooltip(btn, name)

	local page = Instance.new("ScrollingFrame", self.ContentArea)
	page.Size = UDim2.new(1, 0, 1, 0)
	page.BackgroundTransparency = 1
	page.BorderSizePixel = 0
	page.CanvasSize = UDim2.new(0, 0, 0, 0)
	page.AutomaticCanvasSize = Enum.AutomaticSize.Y
	page.ScrollBarThickness = 2
	page.ScrollBarImageColor3 = self.Theme.SubText
	page.Visible = false
	page.Position = UDim2.new(0, 20, 0, 0)
	tab.Page = page

	local layout = Instance.new("UIListLayout", page)
	layout.Padding = UDim.new(0, 8)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	tab.Layout = layout

	local sectionLabel = Instance.new("TextLabel", page)
	sectionLabel.Size = UDim2.new(1, -32, 0, 16)
	sectionLabel.Position = UDim2.new(0, 16, 0, 14)
	sectionLabel.BackgroundTransparency = 1
	sectionLabel.Text = string.upper(name)
	sectionLabel.Font = Enum.Font.Gotham
	sectionLabel.TextSize = 11
	sectionLabel.TextColor3 = self.Theme.SubText
	sectionLabel.TextXAlignment = Enum.TextXAlignment.Left
	sectionLabel.LayoutOrder = -1
	tab.SectionLabel = sectionLabel

	table.insert(self.Tabs, tab)

	if #self.Tabs == 1 and self.IsOpen then
		self:SelectTab(1)
	end

	return tab
end

function Window:SelectTab(index)
	if self.ActiveTabIndex == index then return end
	self.ActiveTabIndex = index

	for i, tab in ipairs(self.Tabs) do
		local active = (i == index)
		local btn = tab.Button
		local icon = btn:FindFirstChild("Icon")
		if active then
			TweenService:Create(btn, TweenInfo.new(0.18), {BackgroundColor3 = self.Theme.TabActive}):Play()
			if icon then
				TweenService:Create(icon, TweenInfo.new(0.18), {ImageColor3 = self.Theme.TabActiveText}):Play()
			end
		else
			TweenService:Create(btn, TweenInfo.new(0.18), {BackgroundColor3 = self.Theme.Btn}):Play()
			if icon then
				TweenService:Create(icon, TweenInfo.new(0.18), {ImageColor3 = self.Theme.Text}):Play()
			end
		end
		btn:SetAttribute("Active", active)
	end

	for i, tab in ipairs(self.Tabs) do
		if i == index then
			tab.Page.Visible = true
			tab.Page.Position = UDim2.new(0, 20, 0, 0)
			TweenService:Create(tab.Page, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)}):Play()
		else
			tab.Page.Visible = false
		end
	end
end

function Window:AddToggle(tabIndex, label, callback)
	local tab = self.Tabs[tabIndex]
	if not tab then return end
	local btn = Instance.new("TextButton", tab.Page)
	btn.Size = UDim2.new(1, -32, 0, 34)
	btn.Position = UDim2.new(0, 16, 0, 0)
	btn.Text = ""
	btn.BackgroundColor3 = self.Theme.Btn
	btn.AutoButtonColor = false
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 12)
	local stroke = Instance.new("UIStroke", btn)
	stroke.Thickness = 1
	stroke.Color = self.Theme.Stroke
	stroke.Transparency = 0.55

	local lbl = Instance.new("TextLabel", btn)
	lbl.Size = UDim2.new(1, -56, 1, 0)
	lbl.Position = UDim2.new(0, 10, 0, 0)
	lbl.BackgroundTransparency = 1
	lbl.Text = label
	lbl.Font = Enum.Font.Gotham
	lbl.TextSize = 13
	lbl.TextColor3 = self.Theme.BtnText
	lbl.TextXAlignment = Enum.TextXAlignment.Left

	local indicator = Instance.new("Frame", btn)
	indicator.Size = UDim2.new(0, 34, 0, 18)
	indicator.Position = UDim2.new(1, -44, 0.5, -9)
	indicator.BackgroundColor3 = Color3.fromRGB(60, 60, 64)
	Instance.new("UICorner", indicator).CornerRadius = UDim.new(1, 0)

	local indicatorCircle = Instance.new("Frame", indicator)
	indicatorCircle.Size = UDim2.new(0, 14, 0, 14)
	indicatorCircle.Position = UDim2.new(0, 2, 0.5, -7)
	indicatorCircle.BackgroundColor3 = Color3.fromRGB(180, 180, 180)
	Instance.new("UICorner", indicatorCircle).CornerRadius = UDim.new(1, 0)

	local state = false
	local element = {
		Button = btn,
		Label = lbl,
		Indicator = indicator,
		Circle = indicatorCircle,
		SetValue = function(self, newState)
			state = newState
			if state then
				TweenService:Create(indicator, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(0, 200, 100)}):Play()
				TweenService:Create(indicatorCircle, TweenInfo.new(0.15), {Position = UDim2.new(0, 18, 0.5, -7)}):Play()
				TweenService:Create(indicatorCircle, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(255, 255, 255)}):Play()
			else
				TweenService:Create(indicator, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(60, 60, 64)}):Play()
				TweenService:Create(indicatorCircle, TweenInfo.new(0.15), {Position = UDim2.new(0, 2, 0.5, -7)}):Play()
				TweenService:Create(indicatorCircle, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(180, 180, 180)}):Play()
			end
			if callback then callback(state) end
		end,
		GetValue = function() return state end,
		Destroy = function()
			btn:Destroy()
		end,
	}

	btn.MouseButton1Click:Connect(function()
		state = not state
		element:SetValue(state)
	end)

	btn.MouseEnter:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = self.Theme.BtnHover}):Play()
	end)
	btn.MouseLeave:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = self.Theme.Btn}):Play()
	end)

	return element
end

function Window:AddButton(tabIndex, label, callback)
	local tab = self.Tabs[tabIndex]
	if not tab then return end
	local btn = Instance.new("TextButton", tab.Page)
	btn.Size = UDim2.new(1, -32, 0, 34)
	btn.Position = UDim2.new(0, 16, 0, 0)
	btn.Text = label
	btn.BackgroundColor3 = self.Theme.Btn
	btn.Font = Enum.Font.Gotham
	btn.TextSize = 13
	btn.TextColor3 = self.Theme.BtnText
	btn.TextXAlignment = Enum.TextXAlignment.Center
	btn.AutoButtonColor = false
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 12)
	local stroke = Instance.new("UIStroke", btn)
	stroke.Thickness = 1
	stroke.Color = self.Theme.Stroke
	stroke.Transparency = 0.55

	local element = {
		Button = btn,
		Fire = function()
			if callback then callback() end
		end,
		Destroy = function()
			btn:Destroy()
		end,
	}

	btn.MouseButton1Click:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = self.Theme.BtnHover}):Play()
		task.wait(0.1)
		TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = self.Theme.Btn}):Play()
		if callback then callback() end
	end)

	btn.MouseEnter:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = self.Theme.BtnHover}):Play()
	end)
	btn.MouseLeave:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = self.Theme.Btn}):Play()
	end)

	return element
end

function Window:AddPlayerPicker(tabIndex, label, callback)
	local tab = self.Tabs[tabIndex]
	if not tab then return end

	local btn = Instance.new("TextButton", tab.Page)
	btn.Size = UDim2.new(1, -32, 0, 34)
	btn.Position = UDim2.new(0, 16, 0, 0)
	btn.Text = label
	btn.BackgroundColor3 = self.Theme.Btn
	btn.Font = Enum.Font.Gotham
	btn.TextSize = 13
	btn.TextColor3 = self.Theme.BtnText
	btn.TextXAlignment = Enum.TextXAlignment.Center
	btn.AutoButtonColor = false
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 12)
	local stroke = Instance.new("UIStroke", btn)
	stroke.Thickness = 1
	stroke.Color = self.Theme.Stroke
	stroke.Transparency = 0.55

	local dropList = Instance.new("ScrollingFrame", btn)
	dropList.Size = UDim2.new(1, 0, 0, 0)
	dropList.Position = UDim2.new(0, 0, 1, 4)
	dropList.BackgroundColor3 = self.Theme.Panel
	dropList.BorderSizePixel = 0
	dropList.Visible = false
	dropList.ZIndex = 10
	dropList.CanvasSize = UDim2.new(0, 0, 0, 0)
	dropList.AutomaticCanvasSize = Enum.AutomaticSize.Y
	dropList.ScrollBarThickness = 2
	dropList.ScrollBarImageColor3 = self.Theme.SubText
	Instance.new("UICorner", dropList).CornerRadius = UDim.new(0, 10)
	local dropStroke = Instance.new("UIStroke", dropList)
	dropStroke.Thickness = 1
	dropStroke.Color = self.Theme.Stroke
	dropStroke.Transparency = 0.35

	local listLayout = Instance.new("UIListLayout", dropList)
	listLayout.Padding = UDim.new(0, 2)
	listLayout.SortOrder = Enum.SortOrder.LayoutOrder

	local isOpen = false
	local element = {
		Button = btn,
		Dropdown = dropList,
		SetLabel = function(self, newLabel)
			btn.Text = newLabel
		end,
		Destroy = function()
			btn:Destroy()
		end,
	}

	local function updateDropdown()
		local players = Players:GetPlayers()
		local height = math.min((#players - 1) * 28 + 4, 120)
		dropList.Size = UDim2.new(1, 0, 0, height)
		dropList.Visible = isOpen

		for _, child in ipairs(dropList:GetChildren()) do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end

		local index = 0
		for _, plr in ipairs(players) do
			if plr ~= LocalPlayer then
				index = index + 1
				local plrBtn = Instance.new("TextButton", dropList)
				plrBtn.Size = UDim2.new(1, -8, 0, 26)
				plrBtn.Position = UDim2.new(0, 4, 0, 0)
				plrBtn.LayoutOrder = index
				plrBtn.BackgroundColor3 = self.Theme.Btn
				plrBtn.Text = plr.Name
				plrBtn.Font = Enum.Font.Gotham
				plrBtn.TextSize = 11
				plrBtn.TextColor3 = self.Theme.BtnText
				plrBtn.TextXAlignment = Enum.TextXAlignment.Left
				plrBtn.AutoButtonColor = false
				plrBtn.ZIndex = 11
				Instance.new("UICorner", plrBtn).CornerRadius = UDim.new(0, 6)

				plrBtn.MouseButton1Click:Connect(function()
					btn.Text = label .. " → " .. plr.Name
					btn.TextColor3 = self.Theme.Text
					isOpen = false
					dropList.Visible = false
					if callback then callback(plr.Name) end
				end)

				plrBtn.MouseEnter:Connect(function()
					TweenService:Create(plrBtn, TweenInfo.new(0.1), {BackgroundColor3 = self.Theme.BtnHover}):Play()
				end)
				plrBtn.MouseLeave:Connect(function()
					TweenService:Create(plrBtn, TweenInfo.new(0.1), {BackgroundColor3 = self.Theme.Btn}):Play()
				end)
			end
		end
	end

	btn.MouseButton1Click:Connect(function()
		isOpen = not isOpen
		updateDropdown()
	end)

	btn.MouseEnter:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = self.Theme.BtnHover}):Play()
	end)
	btn.MouseLeave:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = self.Theme.Btn}):Play()
	end)

	return element
end

-- ============================================================
-- ЭКСПОРТ
-- ============================================================
XuiloUI.new = Window.new

return XuiloUI
