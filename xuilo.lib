local Theme = {}
local currentThemeName = "Dark"
local function setTheme(name)
    local t = Themes[name]; if not t then return end
    currentThemeName = name
    for k in pairs(Theme) do Theme[k] = nil end
    for k, v in pairs(t) do Theme[k] = v end
end
setTheme("Dark")

local themedBindings = {}
local function bind(inst, prop, key)
    themedBindings[#themedBindings+1] = { inst = inst, prop = prop, key = key }
    inst[prop] = Theme[key]
end

-- РАЗМЕРЫ (увеличены)
local CARD_W, CARD_H = 460, 380
local TOPBAR_H       = 38
local SIDEBAR_W      = 130
local GAP            = 10

local function new(class, props, children)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do inst[k] = v end
    for _, c in ipairs(children or {}) do c.Parent = inst end
    return inst
end
local function tween(inst, props, t)
    return TweenService:Create(inst, TweenInfo.new(t or 0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

