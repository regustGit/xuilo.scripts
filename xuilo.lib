local function topbarIconButton(name, symbol, order)
    local btn = new("TextButton", {
        Name = name, Size = UDim2.fromOffset(22, 22),
        BackgroundTransparency = 1, AutoButtonColor = false,
        Text = "", LayoutOrder = order, ZIndex = 2, Parent = Buttons,
    })
    bind(btn, "BackgroundColor3", "ButtonHover")
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 3); c.Parent = btn
    local s = Instance.new("UIStroke"); s.Thickness = 1; s.Transparency = 1; s.Parent = btn
    bind(s, "Color", "CardBorder")

    local icon = new("TextLabel", {
        Name = "Icon", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
        Text = symbol, TextSize = 13, FontFace = PIXEL_FONT, Parent = btn,
    })
    bind(icon, "TextColor3", "Text")

    btn.MouseEnter:Connect(function()
        tween(btn, { BackgroundTransparency = 0 }, 0.1); tween(s, { Transparency = 0.6 }, 0.1)
    end)
    btn.MouseLeave:Connect(function()
        tween(btn, { BackgroundTransparency = 1 }, 0.1); tween(s, { Transparency = 1 }, 0.1)
    end)
    return btn, icon
end

