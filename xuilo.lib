    Position = UDim2.fromOffset(SIDEBAR_W + GAP, 0), Parent = Body,
})
local Content = new("Frame", {
    Size = UDim2.new(1, -8, 1, -8), Position = UDim2.fromOffset(4, 4),
    BackgroundTransparency = 1, Parent = ContentPanel,
})

-- PAGE SYSTEM
local Pages, PageButtons = {}, {}
local currentPage = nil

local function newPage(name)
    local page = new("ScrollingFrame", {
        Name = tostring(name), Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1, BorderSizePixel = 0,
        ScrollBarThickness = 3, ScrollBarImageTransparency = 0.3,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false, Parent = Content,
    })
    bind(page, "ScrollBarImageColor3", "Scroll")
    new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = page })
    new("UIPadding", { PaddingRight = UDim.new(0, 6), PaddingLeft = UDim.new(0, 4), Parent = page })
    Pages[name] = page
    return page
end

local function selectPage(name, instant)
    currentPage = name
    for n, p in pairs(Pages) do p.Visible = (n == name) end
    local t = instant and 0.001 or 0.12
    for n, data in pairs(PageButtons) do
        if n == name then
            tween(data.button, { BackgroundColor3 = Theme.SidebarItemActive }, t)
            tween(data.label,  { TextColor3 = Theme.Text }, t)
            data.stroke.Transparency = 0.3
        else
            tween(data.button, { BackgroundColor3 = Theme.SidebarItem }, t)
            tween(data.label,  { TextColor3 = Theme.TextDim }, t)
            data.stroke.Transparency = 1
        end
    end
end

local function pageButton(name, label, order)
    local btn = new("TextButton", {
        Name = tostring(name), Size = UDim2.new(1, 0, 0, 30), BorderSizePixel = 0,
        AutoButtonColor = false, Text = "", LayoutOrder = order, Parent = Sidebar,
    })
    bind(btn, "BackgroundColor3", "SidebarItem")
    new("UICorner", { CornerRadius = UDim.new(0, 3), Parent = btn })
    local s = new("UIStroke", { Thickness = 1, Transparency = 1, Parent = btn })
    bind(s, "Color", "Accent")
    new("UIPadding", { PaddingLeft = UDim.new(0, 10), Parent = btn })

    local lbl = new("TextLabel", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
        Text = label, TextSize = 12, FontFace = PIXEL_FONT,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = btn,
    })
    bind(lbl, "TextColor3", "TextDim")

    PageButtons[name] = { button = btn, label = lbl, stroke = s }

    btn.MouseButton1Click:Connect(function() selectPage(name) end)
    btn.MouseEnter:Connect(function()
        if currentPage ~= name then tween(btn, { BackgroundColor3 = Theme.SidebarItemHover }, 0.1) end
    end)
    btn.MouseLeave:Connect(function()
        if currentPage ~= name then tween(btn, { BackgroundColor3 = Theme.SidebarItem }, 0.1) end
    end)
    return btn
end

-- TOGGLE
local toggleApplies = {}
local function makeToggle(parent, label, default, order, callback)
    local state = default or false
    local row = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 34), BorderSizePixel = 0,
        AutoButtonColor = false, Text = "", LayoutOrder = order or 0, Parent = parent,
    })
    bind(row, "BackgroundColor3", "Row")
    new("UICorner", { CornerRadius = UDim.new(0, 4), Parent = row })
    local rs = new("UIStroke", { Thickness = 1, Transparency = 0.4, Parent = row })
    bind(rs, "Color", "CardBorder")

    local title = new("TextLabel", {
        Text = label, Size = UDim2.new(1, -70, 1, 0),
        Position = UDim2.fromOffset(12, 0), BackgroundTransparency = 1,
        TextSize = 12, FontFace = PIXEL_FONT,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = row,
    })
    bind(title, "TextColor3", "Text")

    local pill = new("Frame", {
        Size = UDim2.fromOffset(34, 18), Position = UDim2.new(1, -12, 0.5, 0),
        AnchorPoint = Vector2.new(1, 0.5), BorderSizePixel = 0, Parent = row,
    })
    new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = pill })
    local knob = new("Frame", {
        Size = UDim2.fromOffset(12, 12), Position = UDim2.new(0, 3, 0.5, 0),
        AnchorPoint = Vector2.new(0, 0.5), BorderSizePixel = 0, Parent = pill,
    })
    new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = knob })

    local KNOB_ON  = UDim2.new(1, -15, 0.5, 0)
    local KNOB_OFF = UDim2.new(0,   3, 0.5, 0)

    local function apply(instant)
        local t = instant and 0 or 0.15
        if state then
            tween(knob, { Position = KNOB_ON,  BackgroundColor3 = Theme.KnobOn }, t)
            tween(pill, { BackgroundColor3 = Theme.PillOn }, t)
        else
            tween(knob, { Position = KNOB_OFF, BackgroundColor3 = Theme.KnobOff }, t)
            tween(pill, { BackgroundColor3 = Theme.PillOff }, t)
        end
    end
    apply(true)
    toggleApplies[#toggleApplies+1] = function() apply(true) end

    row.MouseEnter:Connect(function()
        tween(row, { BackgroundColor3 = Theme.RowHover }, 0.1); tween(rs, { Transparency = 0.1 }, 0.1)
    end)
    row.MouseLeave:Connect(function()
        tween(row, { BackgroundColor3 = Theme.Row }, 0.1); tween(rs, { Transparency = 0.4 }, 0.1)
    end)
    row.MouseButton1Click:Connect(function()
        state = not state; apply(false)
        if callback then pcall(callback, state) end
    end)

    return {
        get = function() return state end,
        set = function(v) state = v and true or false; apply(false); if callback then pcall(callback, state) end end,
    }
end

-- COLOR PICKER
local function HSVtoRGB(h, s, v)
    local r, g, b
    local i = math.floor(h * 6)
    local f = h * 6 - i
    local p = v * (1 - s)
    local q = v * (1 - f * s)
    local t = v * (1 - (1 - f) * s)
    i = i % 6
    if i == 0 then r, g, b = v, t, p
    elseif i == 1 then r, g, b = q, v, p
    elseif i == 2 then r, g, b = p, v, t
    elseif i == 3 then r, g, b = p, q, v
    elseif i == 4 then r, g, b = t, p, v
    else r, g, b = v, p, q end
    return Color3.new(r, g, b)
end

local function RGBtoHSV(color)
    local r, g, b = color.R, color.G, color.B
    local max, min = math.max(r, g, b), math.min(r, g, b)
    local v = max
    local s = max == 0 and 0 or (max - min) / max
    local h
    if max == min then h = 0
    elseif max == r then h = (g - b) / (max - min) + (g < b and 6 or 0)
    elseif max == g then h = (b - r) / (max - min) + 2
    else h = (r - g) / (max - min) + 4 end
    return h / 6, s, v
end

local function makeColorPicker(parent, label, defaultColor, order, callback)
    local color = defaultColor or Color3.fromRGB(120, 220, 140)
    local h, _s, v = RGBtoHSV(color)

    local row = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 34), BorderSizePixel = 0,
        AutoButtonColor = false, Text = "", LayoutOrder = order or 0, Parent = parent,
    })
    bind(row, "BackgroundColor3", "Row")
    new("UICorner", { CornerRadius = UDim.new(0, 4), Parent = row })
    local rs = new("UIStroke", { Thickness = 1, Transparency = 0.4, Parent = row })
    bind(rs, "Color", "CardBorder")

    local title = new("TextLabel", {
        Text = label, Size = UDim2.new(1, -60, 1, 0),
        Position = UDim2.fromOffset(12, 0), BackgroundTransparency = 1,
        TextSize = 12, FontFace = PIXEL_FONT,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = row,
    })
    bind(title, "TextColor3", "Text")

    local preview = new("Frame", {
        Size = UDim2.fromOffset(22, 22), Position = UDim2.new(1, -12, 0.5, 0),
        AnchorPoint = Vector2.new(1, 0.5), BackgroundColor3 = color,
        BorderSizePixel = 0, Parent = row,
    })
    new("UICorner", { CornerRadius = UDim.new(0, 3), Parent = preview })
    new("UIStroke", { Color = Theme.CardBorder, Thickness = 1, Parent = preview })

    local popup = nil
    local function closePopup() if popup then popup:Destroy(); popup = nil end end

    local function openPopup()
        if popup then closePopup(); return end
        local origH, origV, origColor = h, v, color

        popup = new("Frame", {
            Size = UDim2.fromOffset(230, 195), AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5), BackgroundColor3 = Theme.Panel,
            BorderSizePixel = 0, ZIndex = 50, Parent = ScreenGui,
        })
        new("UICorner", { CornerRadius = UDim.new(0, 6), Parent = popup })
        new("UIStroke", { Color = Theme.CardBorder, Thickness = 1, Parent = popup })
        new("UIPadding", {
            PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10),
            PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10), Parent = popup,
        })

        local sqFrame = new("Frame", {
            Size = UDim2.new(1, 0, 1, -32), BackgroundColor3 = Color3.new(1, 1, 1),
            BorderSizePixel = 0, ClipsDescendants = true, Parent = popup,
        })
        new("UICorner", { CornerRadius = UDim.new(0, 4), Parent = sqFrame })
        new("UIGradient", {
            Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255,   0,   0)),
                ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255,   0)),
                ColorSequenceKeypoint.new(0.33, Color3.fromRGB(  0, 255,   0)),
                ColorSequenceKeypoint.new(0.50, Color3.fromRGB(  0, 255, 255)),
                ColorSequenceKeypoint.new(0.67, Color3.fromRGB(  0,   0, 255)),
                ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255,   0, 255)),
                ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255,   0,   0)),
            }), Parent = sqFrame,
        })
        local briFrame = new("Frame", {
            Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1),
            BorderSizePixel = 0, Parent = sqFrame,
        })
        new("UIGradient", {
            Color = ColorSequence.new(Color3.new(0, 0, 0)),
            Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 1),
                NumberSequenceKeypoint.new(1, 0),
            }), Rotation = 90, Parent = briFrame,
        })

        local dot = new("Frame", {
            Size = UDim2.fromOffset(12, 12), AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(h, 0, 1 - v, 0), BackgroundTransparency = 1,
            ZIndex = 5, Parent = sqFrame,
        })
        new("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 2, Parent = dot })

        local hit = new("TextButton", {
            Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
            Text = "", AutoButtonColor = false, ZIndex = 6, Parent = sqFrame,
        })

        local okBtn = new("TextButton", {
            Size = UDim2.new(0.48, 0, 0, 24), Position = UDim2.new(1, 0, 1, 0),
            AnchorPoint = Vector2.new(1, 1), BackgroundColor3 = Theme.SidebarItemActive,
            BorderSizePixel = 0, AutoButtonColor = false, Text = "OK",
            TextSize = 12, FontFace = PIXEL_FONT, TextColor3 = Theme.Text, Parent = popup,
        })
        new("UICorner", { CornerRadius = UDim.new(0, 4), Parent = okBtn })

        local cancelBtn = new("TextButton", {
            Size = UDim2.new(0.48, 0, 0, 24), Position = UDim2.new(0, 0, 1, 0),
            AnchorPoint = Vector2.new(0, 1), BackgroundColor3 = Theme.Row,
            BorderSizePixel = 0, AutoButtonColor = false, Text = "Cancel",
            TextSize = 12, FontFace = PIXEL_FONT, TextColor3 = Theme.TextDim, Parent = popup,
        })
        new("UICorner", { CornerRadius = UDim.new(0, 4), Parent = cancelBtn })

        local dragging = false
        local function setFromPos(x, y)
            local relX = (x - sqFrame.AbsolutePosition.X) / math.max(sqFrame.AbsoluteSize.X, 1)
            local relY = (y - sqFrame.AbsolutePosition.Y) / math.max(sqFrame.AbsoluteSize.Y, 1)
            h = math.clamp(relX, 0, 1)
            v = 1 - math.clamp(relY, 0, 1)
            dot.Position = UDim2.new(h, 0, 1 - v, 0)
        end

        hit.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                setFromPos(input.Position.X, input.Position.Y)
            end
        end)
        local conn
        conn = UserInputService.InputChanged:Connect(function(input)
            if not popup or not popup.Parent then pcall(function() conn:Disconnect() end); return end
            if not dragging then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch then
                setFromPos(input.Position.X, input.Position.Y)
            end
        end)
        local conn2
        conn2 = UserInputService.InputEnded:Connect(function(input)
            if not popup or not popup.Parent then pcall(function() conn2:Disconnect() end); return end
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)

        okBtn.MouseButton1Click:Connect(function()
            color = HSVtoRGB(h, 1, v)
            preview.BackgroundColor3 = color
            if callback then pcall(callback, color) end
            closePopup()
        end)
        cancelBtn.MouseButton1Click:Connect(function()
            h, v, color = origH, origV, origColor
            closePopup()
        end)
    end

    row.MouseEnter:Connect(function()
        tween(row, { BackgroundColor3 = Theme.RowHover }, 0.1); tween(rs, { Transparency = 0.1 }, 0.1)
    end)
    row.MouseLeave:Connect(function()
        tween(row, { BackgroundColor3 = Theme.Row }, 0.1); tween(rs, { Transparency = 0.4 }, 0.1)
    end)
    row.MouseButton1Click:Connect(openPopup)

    return {
        get = function() return color end,
        set = function(c)
            color = c
            h, _s, v = RGBtoHSV(c)
            preview.BackgroundColor3 = c
            if callback then pcall(callback, c) end
        end,
    }
end

-- Кнопка (обычная, с текстом)
local function makeButton(parent, label, order, callback)
    local btn = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 34), BorderSizePixel = 0,
        AutoButtonColor = false, Text = "", LayoutOrder = order or 0, Parent = parent,
    })
    bind(btn, "BackgroundColor3", "Row")
    new("UICorner", { CornerRadius = UDim.new(0, 4), Parent = btn })
    local rs = new("UIStroke", { Thickness = 1, Transparency = 0.4, Parent = btn })
    bind(rs, "Color", "CardBorder")

    local title = new("TextLabel", {
        Text = label, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
        TextSize = 12, FontFace = PIXEL_FONT, TextColor3 = Theme.Text, Parent = btn,
    })
    bind(title, "TextColor3", "Text")

    btn.MouseEnter:Connect(function()
        tween(btn, { BackgroundColor3 = Theme.RowHover }, 0.1); tween(rs, { Transparency = 0.1 }, 0.1)
    end)
    btn.MouseLeave:Connect(function()
        tween(btn, { BackgroundColor3 = Theme.Row }, 0.1); tween(rs, { Transparency = 0.4 }, 0.1)
    end)
    btn.MouseButton1Click:Connect(function()
        if callback then pcall(callback) end
    end)
    return btn
end

-- Текст-строка (label + value)
local function makeLabel(parent, label, value, order)
    local row = new("Frame", {
        Size = UDim2.new(1, 0, 0, 34), BorderSizePixel = 0,
        LayoutOrder = order or 0, Parent = parent,
    })
    bind(row, "BackgroundColor3", "Row")
    new("UICorner", { CornerRadius = UDim.new(0, 4), Parent = row })
    local rs = new("UIStroke", { Thickness = 1, Transparency = 0.4, Parent = row })
    bind(rs, "Color", "CardBorder")

    local l = new("TextLabel", {
        Text = label, Size = UDim2.new(0.5, 0, 1, 0),
        Position = UDim2.fromOffset(12, 0), BackgroundTransparency = 1,
        TextSize = 12, FontFace = PIXEL_FONT,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = row,
    })
    bind(l, "TextColor3", "Text")

    local v = new("TextLabel", {
        Text = tostring(value), Size = UDim2.new(0.5, -12, 1, 0),
        Position = UDim2.new(1, -12, 0, 0), AnchorPoint = Vector2.new(1, 0),
        BackgroundTransparency = 1, TextSize = 12, FontFace = PIXEL_FONT,
        TextXAlignment = Enum.TextXAlignment.Right, Parent = row,
    })
    bind(v, "TextColor3", "TextDim")

    return {
        instance = row,
        set = function(txt) v.Text = tostring(txt) end,
    }
end

-- Segmented control (2 варианта)
local function makeSegment(parent, label, options, default, order, callback)
    local current = default or options[1]

    local row = new("Frame", {
        Size = UDim2.new(1, 0, 0, 34), BorderSizePixel = 0,
        LayoutOrder = order or 0, Parent = parent,
    })
    bind(row, "BackgroundColor3", "Row")
    new("UICorner", { CornerRadius = UDim.new(0, 4), Parent = row })
    local rs = new("UIStroke", { Thickness = 1, Transparency = 0.4, Parent = row })
    bind(rs, "Color", "CardBorder")

    local title = new("TextLabel", {
        Text = label, Size = UDim2.new(1, -160, 1, 0),
        Position = UDim2.fromOffset(12, 0), BackgroundTransparency = 1,
        TextSize = 12, FontFace = PIXEL_FONT,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = row,
    })
    bind(title, "TextColor3", "Text")

    local seg = new("Frame", {
        Size = UDim2.fromOffset(140, 24), AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0), BorderSizePixel = 0, Parent = row,
    })
    bind(seg, "BackgroundColor3", "Panel")
    new("UICorner", { CornerRadius = UDim.new(0, 4), Parent = seg })
    new("UIPadding", {
        PaddingLeft = UDim.new(0, 2), PaddingRight = UDim.new(0, 2),
        PaddingTop  = UDim.new(0, 2), PaddingBottom = UDim.new(0, 2), Parent = seg,
    })

    local buttons = {}
    local function refresh()
        for _, b in ipairs(buttons) do
            if b.label.Text == current then
                b.btn.BackgroundColor3 = Theme.SidebarItemActive
                b.lbl.TextColor3 = Theme.Text
            else
                b.btn.BackgroundColor3 = Theme.Panel
                b.lbl.TextColor3 = Theme.TextDim
            end
        end
    end

    for i, opt in ipairs(options) do
        local b = new("TextButton", {
            Text = "", AutoButtonColor = false, BorderSizePixel = 0,
            Position = UDim2.new((i-1) / #options, 0, 0, 0),
            Size = UDim2.new(1 / #options, -1, 1, 0), Parent = seg,
        })
        new("UICorner", { CornerRadius = UDim.new(0, 2), Parent = b })
        local lbl = new("TextLabel", {
            Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
            Text = opt, TextSize = 11, FontFace = PIXEL_FONT, Parent = b,
        })
        b.MouseButton1Click:Connect(function()
            current = opt
            refresh()
            if callback then pcall(callback, opt) end
        end)
        buttons[#buttons+1] = { btn = b, lbl = lbl, label = lbl, text = opt }
    end
    refresh()

    return {
        get = function() return current end,
        set = function(v) current = v; refresh(); if callback then pcall(callback, v) end end,
        refresh = refresh,
    }
end

-- THEME
local function applyAllTheme()
    for _, e in ipairs(themedBindings) do e.inst[e.prop] = Theme[e.key] end
    Pattern.ImageTransparency = Theme.PatternTransparency
    for _, fn in ipairs(toggleApplies) do fn() end
    if currentPage then selectPage(currentPage, true) end
end

-- COLLAPSE / SHOW / HIDE
local collapsed = false
local closing, uiOpen = false, false

local function setCollapsed(value)
    collapsed = value
    local targetH = collapsed and TOPBAR_H or CARD_H
    CollapseIcon.Text = collapsed and "+" or "−"
    tween(CanvasGroup, { Size = UDim2.fromOffset(CARD_W, targetH) }, 0.22)
end

local function showUI()
    closing = false; uiOpen = true
    ScreenGui.Enabled = true
    CanvasGroup.GroupTransparency = 1
    Scale.Scale = 0.92
    local targetH = collapsed and TOPBAR_H or CARD_H
    CanvasGroup.Size = UDim2.fromOffset(CARD_W, targetH)
    tween(CanvasGroup, { GroupTransparency = 0 }, 0.18)
    tween(Scale, { Scale = 1 }, 0.22)
    UserInputService.ModalEnabled = true
    UserInputService.MouseIconEnabled = true
end

local function hideUI()
    if closing then return end
    closing = true; uiOpen = false
    tween(CanvasGroup, { GroupTransparency = 1 }, 0.15)
    tween(Scale, { Scale = 0.92 }, 0.15)
    task.delay(0.15, function() if closing then ScreenGui.Enabled = false end end)
    UserInputService.ModalEnabled = false
end

local function toggleUI() if uiOpen then hideUI() else showUI() end end

showUI()

ContextActionService:BindAction("XuiloUI_Toggle", function(_, s)
    if s == Enum.UserInputState.Begin then toggleUI() end
    return Enum.ContextActionResult.Sink
end, false, Enum.KeyCode.RightShift)

CloseBtn.MouseButton1Click:Connect(hideUI)
CollapseBtn.MouseButton1Click:Connect(function() setCollapsed(not collapsed) end)

-- TILT + DRAG
local MAX_TILT = 2.5
local currentTilt = 0
local dragging = false
local dragStartMouse, dragStartPixels = Vector2.new(), Vector2.new()
local dragTargetPixels = nil

local function getPixelPos(u)
    local vp = workspace.CurrentCamera.ViewportSize
    return Vector2.new(u.X.Scale * vp.X + u.X.Offset, u.Y.Scale * vp.Y + u.Y.Offset)
end

RunService.RenderStepped:Connect(function(dt)
    if uiOpen then
        local vp = workspace.CurrentCamera.ViewportSize
        local mouse = UserInputService:GetMouseLocation()
        local cx = vp.X * 0.5
        local nx = math.clamp((mouse.X - cx) / cx, -1, 1)
        local a = math.clamp(dt * 8, 0, 1)
        currentTilt = currentTilt + (nx * MAX_TILT - currentTilt) * a
        CanvasGroup.Rotation = currentTilt
    end
    if dragging and dragTargetPixels then
        local cur = getPixelPos(CanvasGroup.Position)
        local a = math.clamp(dt * 18, 0, 1)
        local newPix = cur + (dragTargetPixels - cur) * a
        CanvasGroup.Position = UDim2.fromOffset(newPix.X, newPix.Y)
    end
end)

Topbar.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStartMouse   = Vector2.new(input.Position.X, input.Position.Y)
        dragStartPixels  = getPixelPos(CanvasGroup.Position)
        dragTargetPixels = dragStartPixels
        CanvasGroup.Position = UDim2.fromOffset(dragStartPixels.X, dragStartPixels.Y)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not dragging then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement
        and input.UserInputType ~= Enum.UserInputType.Touch then return end
    local mousePos = Vector2.new(input.Position.X, input.Position.Y)
    dragTargetPixels = dragStartPixels + (mousePos - dragStartMouse)
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
        dragTargetPixels = nil
    end
end)

-- ==================== API (обёртки с self) ====================
local API = {}
function API:newPage(name)                                    return newPage(name) end
function API:pageButton(name, label, order)                   return pageButton(name, label, order) end
function API:selectPage(name, instant)                        return selectPage(name, instant) end
function API:makeToggle(page, label, default, order, cb)      return makeToggle(page, label, default, order, cb) end
function API:makeColorPicker(page, label, color, order, cb)   return makeColorPicker(page, label, color, order, cb) end
function API:makeButton(page, label, order, cb)               return makeButton(page, label, order, cb) end
function API:makeLabel(page, label, value, order)             return makeLabel(page, label, value, order) end
function API:makeSegment(page, label, options, default, order, cb) return makeSegment(page, label, options, default, order, cb) end
function API:setTheme(name)                                   setTheme(name); applyAllTheme() end
function API:getTheme()                                       return currentThemeName end
function API:toggleUI()                                       toggleUI() end
function API:show()                                           showUI() end
function API:hide()                                           hideUI() end
function API:setCollapsed(v)                                  setCollapsed(v) end
API.ScreenGui = ScreenGui
API.Theme     = Theme
return API
