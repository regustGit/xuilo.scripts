    Position = UDim2.new(1, -10, 0.5, 0), BackgroundTransparency = 1, ZIndex = 2, Parent = Topbar,
})
new("UIListLayout", {
    FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4),
    VerticalAlignment = Enum.VerticalAlignment.Center,
    HorizontalAlignment = Enum.HorizontalAlignment.Right,
    SortOrder = Enum.SortOrder.LayoutOrder, Parent = Buttons,
})

local function topbarIconButton(symbol, order)
    local btn = new("TextButton", {
        Size = UDim2.fromOffset(24, 24), BackgroundTransparency = 1,
        AutoButtonColor = false, Text = "", LayoutOrder = order, ZIndex = 2, Parent = Buttons,
    })
    bind(btn, "BackgroundColor3", "ButtonHover")
    new("UICorner", { CornerRadius = UDim.new(0, 3), Parent = btn })
    local s = new("UIStroke", { Thickness = 1, Transparency = 1, Parent = btn })
    bind(s, "Color", "CardBorder")
    local icon = new("TextLabel", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
        Text = symbol, TextSize = 14, FontFace = PIXEL_FONT, Parent = btn,
    })
    bind(icon, "TextColor3", "Text")
    btn.MouseEnter:Connect(function()
        tween(btn, { BackgroundTransparency = 0 }, 0.1); tween(s, { Transparency = 0.6 }, 0.1)
    end)
    btn.MouseLeave:Connect(function()
        tween(btn, { BackgroundTransparency = 1 }, 0.1); tween(s, { Transparency = 1 }, 0.1)
    end)
    return btn, icon
end

local CollapseBtn, CollapseIcon = topbarIconButton("−", 2)
local CloseBtn                  = topbarIconButton("x", 3)

